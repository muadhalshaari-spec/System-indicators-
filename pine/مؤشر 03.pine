//@version=5
indicator("Aggregated Open Interest [Alpha Extract]", format=format.volume)

//           /\\      ||  _______             █████╗  ██╗     ██████╗ ██╗  ██╗ █████╗     ███████╗██╗  ██╗████████╗██████╗  █████╗  ██████╗████████╗
//          /  \\     || |                    ██╔══██╗██║     ██╔══██╗██║  ██║██╔══██╗    ██╔════╝╚██╗██╔╝╚══██╔══╝██╔══██╗██╔══██╗██╔════╝╚══██╔══╝
//         /____\\    || |_______             ███████║██║     ██████╔╝███████║███████║    █████╗   ╚███╔╝    ██║   ██████╔╝███████║██║        ██║   
//        /      \\   || |                    ██╔══██║██║     ██╔═══╝ ██╔══██║██╔══██║    ██╔══╝   ██╔██╗    ██║   ██╔══██╗██╔══██║██║        ██║   
//       /        \\  || |_______             ██║  ██║███████╗██║     ██║  ██║██║  ██║    ███████╗██╔╝ ██╗   ██║   ██║  ██║██║  ██║╚██████╗   ██║   
//                                            ╚═╝  ╚═╝╚══════╝╚═╝     ╚═╝  ╚═╝╚═╝  ╚═╝    ╚══════╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝   ╚═╝   

// ===== Configuration Settings =====
g1 = "Data Sources"
g2 = "Display Settings"
g3 = "Analysis Tools"
g5 = "OI Divergence Detection"

// Display settings

display_mode = input.string("Open Interest", "Display Mode", 
               options=["Open Interest", "OI Change", "OI Delta", "OI Delta × Volume", "OI RSI", "OI Heatmap"], 
               group=g2)
currency_unit = input.string("USD", "Currency Units", options=["USD", "COIN"], group=g2)
up_color = input.color(#26a69a, "Up Color", group=g2)
down_color = input.color(#ef5350, "Down Color", group=g2)

// Data source toggles
use_binance_usdt = input.bool(true, "Binance USDT Perpetuals", group = "Binance")
use_binance_usd = input.bool(true, "Binance USD Perpetuals", group = "Binance")
use_binance_busd = input.bool(true, "Binance BUSD Perpetuals", group = "Binance")
use_bitmex_usd = input.bool(true, "BitMEX USD Perpetuals", group = "Bitmex")
use_bitmex_usdt = input.bool(true, "BitMEX USDT Perpetuals", group = "Bitmex")
use_kraken_usd = input.bool(true, "Kraken USD Perpetuals" , group = "Kraken")

// Analysis settings
show_ma = input.bool(false, "Show MA", group=g3, inline="ma")
ma_length = input.int(50, "", group=g3, inline="ma", minval=1)
ma_color = input.color(color.gray, "", group=g3, inline="ma")
rsi_length = input.int(14, "RSI Length", group=g3, inline="rsi")
rsi_color = input.color(color.gray, "", group=g3, inline="rsi")

// OI Divergence Detection settings
show_divergence = input.bool(false, "Show Divergence Signals", group=g5)
div_lookback = input.int(20, "Lookback Period", group=g5)
div_threshold = input.float(5, "Divergence Threshold (%)", group=g5, step=0.1)
div_bull_color = input.color(#26a69a, "Bullish Divergence", group=g5, inline="div_color1")
div_bear_color = input.color(#ef5350, "Bearish Divergence", group=g5, inline="div_color2")

// ===== Data Collection =====

base_currency = syminfo.basecurrency
bitmex_currency = base_currency == "BTC" ? "XBT" : base_currency

// Get the current price for normalization
current_price = close

// Binance USDT perpetual
[oidBinanceUsdt, oicBinanceUsdt, oioBinanceUsdt, oihBinanceUsdt, oilBinanceUsdt] = request.security("BINANCE:" + base_currency + "USDT.P_OI", timeframe.period, [close - close[1], close, open, high, low], ignore_invalid_symbol=true)

// Binance USD perpetual
[oidBinanceUsd, oicBinanceUsd, oioBinanceUsd, oihBinanceUsd, oilBinanceUsd] = request.security("BINANCE:" + base_currency + "USD.P_OI", timeframe.period, [close - close[1], close, open, high, low], ignore_invalid_symbol=true)

// Binance BUSD perpetual
[oidBinanceBusd, oicBinanceBusd, oioBinanceBusd, oihBinanceBusd, oilBinanceBusd] = request.security("BINANCE:" + base_currency + "BUSD.P_OI", timeframe.period, [close - close[1], close, open, high, low], ignore_invalid_symbol=true)

// BitMEX USD perpetual
[oidBitmexUsd, oicBitmexUsd, oioBitmexUsd, oihBitmexUsd, oilBitmexUsd] = request.security("BITMEX:" + bitmex_currency + "USD.P_OI", timeframe.period, [close - close[1], close, open, high, low], ignore_invalid_symbol=true)

// BitMEX USDT perpetual
[oidBitmexUsdt, oicBitmexUsdt, oioBitmexUsdt, oihBitmexUsdt, oilBitmexUsdt] = request.security("BITMEX:" + bitmex_currency + "USDT.P_OI", timeframe.period, [close - close[1], close, open, high, low], ignore_invalid_symbol=true)

// Kraken USD perpetual
[oidKrakenUsd, oicKrakenUsd, oioKrakenUsd, oihKrakenUsd, oilKrakenUsd] = request.security("KRAKEN:" + base_currency + "USD.P_OI", timeframe.period, [close - close[1], close, open, high, low], ignore_invalid_symbol=true)


// Delta value calculation 
delta_oi = (use_binance_usdt ? nz(oidBinanceUsdt, 0) : 0) + 
           (use_binance_usd ? nz(oidBinanceUsd, 0) / current_price : 0) + 
           (use_binance_busd ? nz(oidBinanceBusd, 0) : 0) + 
           (use_bitmex_usd ? nz(oidBitmexUsd, 0) / current_price : 0) + 
           (use_bitmex_usdt ? nz(oidBitmexUsdt, 0) / current_price : 0) + 
           (use_kraken_usd ? nz(oidKrakenUsd, 0) / current_price : 0)

// OHLC values for plotting 
O =  (use_binance_usdt ? nz(oioBinanceUsdt, 0) : 0) + 
     (use_binance_usd ? nz(oioBinanceUsd, 0) / current_price : 0) + 
     (use_binance_busd ? nz(oioBinanceBusd, 0) : 0) + 
     (use_bitmex_usd ? nz(oioBitmexUsd, 0) / current_price : 0) + 
     (use_bitmex_usdt ? nz(oioBitmexUsdt, 0) / current_price : 0) + 
     (use_kraken_usd ? nz(oioKrakenUsd, 0) / current_price : 0)

H =  (use_binance_usdt ? nz(oihBinanceUsdt, 0) : 0) + 
     (use_binance_usd ? nz(oihBinanceUsd, 0) / current_price : 0) + 
     (use_binance_busd ? nz(oihBinanceBusd, 0) : 0) + 
     (use_bitmex_usd ? nz(oihBitmexUsd, 0) / current_price : 0) + 
     (use_bitmex_usdt ? nz(oihBitmexUsdt, 0) / current_price : 0) + 
     (use_kraken_usd ? nz(oihKrakenUsd, 0) / current_price : 0)

L =  (use_binance_usdt ? nz(oilBinanceUsdt, 0) : 0) + 
     (use_binance_usd ? nz(oilBinanceUsd, 0) / current_price : 0) + 
     (use_binance_busd ? nz(oilBinanceBusd, 0) : 0) + 
     (use_bitmex_usd ? nz(oilBitmexUsd, 0) / current_price : 0) + 
     (use_bitmex_usdt ? nz(oilBitmexUsdt, 0) / current_price : 0) + 
     (use_kraken_usd ? nz(oilKrakenUsd, 0) / current_price : 0)

C =  (use_binance_usdt ? nz(oicBinanceUsdt, 0) : 0) + 
     (use_binance_usd ? nz(oicBinanceUsd, 0) / current_price : 0) + 
     (use_binance_busd ? nz(oicBinanceBusd, 0) : 0) + 
     (use_bitmex_usd ? nz(oicBitmexUsd, 0) / current_price : 0) + 
     (use_bitmex_usdt ? nz(oicBitmexUsdt, 0) / current_price : 0) + 
     (use_kraken_usd ? nz(oicKrakenUsd, 0) / current_price : 0)

// Normalize based on currency display preference
O_ = currency_unit == "COIN" ? O : O * current_price
H_ = currency_unit == "COIN" ? H : H * current_price
L_ = currency_unit == "COIN" ? L : L * current_price
C_ = currency_unit == "COIN" ? C : C * current_price
delta_oi_ = currency_unit == "COIN" ? delta_oi : delta_oi * current_price

// ===== NEW: OI Change Calculations (Similar to the second script) =====

oi_change = C_ - C_[1]
oi_wick_high = H_ - C_[1]
oi_wick_low = L_ - C_[1]

// ===== Analysis =====

// Relative volume for OI × Volume mode
rel_vol = volume / ta.sma(volume, 20)
vol_weighted_delta = delta_oi_ * rel_vol

// OI RSI
oi_rsi = ta.rsi(C_, rsi_length)

// Moving average
oi_ma = ta.ema(C_, ma_length)

// ===== Display Logic =====

// Determine what to display based on selected mode
show_candles = display_mode == "Open Interest"
show_oi_change = display_mode == "OI Change" 
show_delta = display_mode == "OI Delta"
show_vol_delta = display_mode == "OI Delta × Volume"
show_rsi = display_mode == "OI RSI"

// Set coloring logic
candle_color = C_ > O_ ? up_color : down_color
delta_color = delta_oi_ > 0 ? up_color : down_color
oi_change_color = oi_change > 0 ? up_color : down_color
vol_delta_color = vol_weighted_delta > 0 ? up_color : down_color

// ===== OI Divergence Detection =====
var float prev_high_price = 0.0
var float prev_high_oi = 0.0
var int prev_high_index = 0
var float prev_low_price = 0.0
var float prev_low_oi = 0.0
var int prev_low_index = 0
var bool bearish_div = false
var bool bullish_div = false

// Find pivot highs and lows
is_high_pivot = ta.pivothigh(high, 2, 2)
is_low_pivot = ta.pivotlow(low, 2, 2)

// Reset divergence signals at the start of each bar
bearish_div := false
bullish_div := false

if show_divergence
    
    if not na(is_high_pivot)
        float current_high = is_high_pivot
        
        
        if prev_high_price > 0 and (bar_index - prev_high_index) <= div_lookback
            
            if current_high > prev_high_price and C_ < prev_high_oi
                
                float oi_pct_change = (C_ - prev_high_oi) / prev_high_oi * 100
                if math.abs(oi_pct_change) > div_threshold
                    bearish_div := true
        
        // Update previous high values
        prev_high_price := current_high
        prev_high_oi := C_
        prev_high_index := bar_index
    
    // Process pivot lows for bullish divergence
    if not na(is_low_pivot)
        float current_low = is_low_pivot
        
        
        if prev_low_price > 0 and (bar_index - prev_low_index) <= div_lookback
            
            if current_low < prev_low_price and C_ > prev_low_oi
                
                float oi_pct_change = (C_ - prev_low_oi) / prev_low_oi * 100
                if math.abs(oi_pct_change) > div_threshold
                    bullish_div := true
        
        // Update previous low values
        prev_low_price := current_low
        prev_low_oi := C_
        prev_low_index := bar_index

// ===== Plotting Elements =====

// Plot based on selected display mode
plotcandle(show_candles ? O_ : na, 
           show_candles? H_ : na, 
           show_candles ? L_ : na, 
           show_candles ? C_ : na, title="Open Interest", 
           color=candle_color, 
           wickcolor=candle_color, 
           bordercolor=candle_color)

// New: Plot OI Change with wicks
plot(show_oi_change ? oi_change : na, 
     title="OI Change", style=plot.style_columns, 
     color=oi_change_color)

// Plot OI Delta
plot(show_delta ? delta_oi_ : 
     show_vol_delta ? vol_weighted_delta : na, 
     title="OI Delta", style=plot.style_columns, 
     color=show_delta ? delta_color : vol_delta_color)


     
plot(show_oi_change ? oi_wick_high : na, 
     title="OI Change High", style=plot.style_histogram, 
     color=oi_change_color)
     
plot(show_oi_change ? oi_wick_low : na, 
     title="OI Change Low", style=plot.style_histogram, 
     color=oi_change_color)

// Plot RSI
plot(show_rsi ? oi_rsi : na,
     title="OI RSI", 
     color=rsi_color)

// Plot supporting elements
plot(show_ma and 
     (show_candles or show_delta or show_vol_delta or show_oi_change) ? oi_ma : na, 
     title="OI MA", color=ma_color)

// RSI reference lines
hline(show_rsi ? 70 : na, title="RSI Overbought", color=color.new(color.gray, 50))
hline(show_rsi ? 50 : na, title="RSI Midline", color=color.new(color.gray, 50))
hline(show_rsi ? 30 : na, title="RSI Oversold", color=color.new(color.gray, 50))

// Plot divergence signals

plotshape(show_divergence and bearish_div ? high + (high * 0.1) : na, 
          "Bearish OI Divergence Outer", 
          shape.circle, 
          location.absolute, 
          color.new(div_bear_color, 90), 
          size=size.tiny,
          force_overlay = true)

plotshape(show_divergence and bearish_div ? high + (high * 0.1) : na, 
          "Bearish OI Divergence Middle", 
          shape.circle, 
          location.absolute, 
          color.new(div_bear_color, 80), 
          size=size.small,
          force_overlay = true)

plotshape(show_divergence and bearish_div ? high + (high * 0.1) : na, 
          "Bearish OI Divergence Inner", 
          shape.circle, 
          location.absolute, 
          div_bear_color, 
          size=size.tiny,
          force_overlay = true)

// Bullish divergence markers 
plotshape(show_divergence and bullish_div ? low - (low * 0.1) : na, 
          "Bullish OI Divergence Outer", 
          shape.circle, 
          location.absolute, 
          color.new(div_bull_color, 90), 
          size=size.tiny,
          force_overlay = true)

plotshape(show_divergence and bullish_div ? low - (low * 0.1) : na, 
          "Bullish OI Divergence Middle", 
          shape.circle, 
          location.absolute, 
          color.new(div_bull_color, 80), 
          size=size.small,
          force_overlay = true)

plotshape(show_divergence and bullish_div ? low - (low * 0.1) : na, 
          "Bullish OI Divergence Inner", 
          shape.circle, 
          location.absolute, 
          div_bull_color, 
          size=size.tiny,
          force_overlay = true)

// ===== Grid-Style Market Analysis Table =====
if barstate.islast
    var table stats = table.new(position.top_right, 2, 7, 
                               bgcolor=color.new(color.black, 0),     
                               frame_width=1,                         
                               frame_color=color.gray)                
    
    // Title row
    table.cell(stats, 0, 0, "AE - OI Aggregator", 
               text_color=color.white,
               bgcolor=#252525,                          
               text_halign=text.align_left,              
               text_size=size.normal)                    
    
    // Currency symbol
    table.cell(stats, 1, 0, currency_unit == "USD" ? "$" : base_currency, 
               text_color=color.white,
               bgcolor=#252525,                          
               text_halign=text.align_center)            
    
    // Row 1: Aggregate OI
    table.cell(stats, 0, 1, "Aggregate OI:", 
               text_color=color.white,
               bgcolor=#1E1E1E,                          
               text_halign=text.align_left)              
    
    table.cell(stats, 1, 1, str.tostring(C_, format.volume), 
               text_color=C_ > C_[1] ? up_color : down_color,
               bgcolor=#1E1E1E,                          
               text_halign=text.align_right)             
    
    // Row 2: Recent Change
    table.cell(stats, 0, 2, "Recent Change:", 
               text_color=color.white,
               bgcolor=#252525,                          
               text_halign=text.align_left)
    
    table.cell(stats, 1, 2, str.tostring(oi_change, format.volume), 
               text_color=oi_change > 0 ? up_color : down_color,
               bgcolor=#252525,                          
               text_halign=text.align_right)
    
    // Calculate activity metrics
    float bullish_activity = 0.0
    float bearish_activity = 0.0
    
    for i = 0 to 50
        if delta_oi_[i] > 0 and close[i] > open[i]
            bullish_activity := bullish_activity + delta_oi_[i]
        if delta_oi_[i] < 0 and close[i] < open[i]
            bearish_activity := bearish_activity + math.abs(delta_oi_[i])
    
    // Row 3: Bullish Activity
    table.cell(stats, 0, 3, "Bullish Activity:", 
               text_color=color.white,
               bgcolor=#1E1E1E,                          
               text_halign=text.align_left)
    
    table.cell(stats, 1, 3, str.tostring(bullish_activity, format.volume), 
               text_color=up_color,
               bgcolor=#1E1E1E,                          
               text_halign=text.align_right)
    
    // Row 4: Bearish Activity
    table.cell(stats, 0, 4, "Bearish Activity:", 
               text_color=color.white,
               bgcolor=#252525,                          
               text_halign=text.align_left)
    
    table.cell(stats, 1, 4, str.tostring(bearish_activity, format.volume), 
               text_color=down_color,
               bgcolor=#252525,                          
               text_halign=text.align_right)
    
    // Calculate Bull/Bear Ratio
    float oi_ratio = bearish_activity != 0 ? bullish_activity / bearish_activity : 1.0
    
    table.cell(stats, 0, 5, "Bull/Bear Ratio:", 
               text_color=color.white,
               bgcolor=#1E1E1E,                          
               text_halign=text.align_left)
    
    table.cell(stats, 1, 5, str.tostring(oi_ratio, "#.##"), 
               text_color=oi_ratio >= 1.0 ? up_color : down_color,
               bgcolor=#1E1E1E,                          
               text_halign=text.align_right)
    
    if show_divergence
        table.cell(stats, 0, 6, "OI Divergence:", 
                  text_color=color.white,
                  bgcolor=#252525,                       
                  text_halign=text.align_left)
        
        string div_status = "NONE"
        color div_color = color.white
        
        if bearish_div
            div_status := "BEARISH"
            div_color := div_bear_color
        else if bullish_div
            div_status := "BULLISH"
            div_color := div_bull_color
        
        table.cell(stats, 1, 6, div_status, 
                  text_color=div_color,
                  bgcolor=#252525,                       
                  text_halign=text.align_right)

/// ===== Multi-Timeframe Open Interest Heatmap =====
g4 = "OI Heatmap"

// Heatmap settings
heat_bull_color = input.color(#008000, "Bullish Signal", group=g4, inline="heat_color1")
heat_bear_color = input.color(#FF0000, "Bearish Signal", group=g4, inline="heat_color2")

// Fixed set of lookback periods

var p1 = 3
var p2 = 5 
var p3 = 8
var p4 = 13
var p5 = 21
var p6 = 34
var p7 = 55

// Variables to store period values for each row
var float row1 = na
var float row2 = na
var float row3 = na
var float row4 = na
var float row5 = na
var float row6 = na
var float row7 = na

// Variables to store colors for each row \\
var color row1_color = color.gray
var color row2_color = color.gray
var color row3_color = color.gray
var color row4_color = color.gray
var color row5_color = color.gray
var color row6_color = color.gray
var color row7_color = color.gray

/// Determine if heatmap mode is selected
show_oi_heatmap = display_mode == "OI Heatmap"


if show_oi_heatmap
    // Row 1 (Period 3)
    oi_change_pct1 = ((C_ - C_[p1]) / C_[p1]) * 100
    row1 := 1
    row1_color := oi_change_pct1 > 0 ? heat_bull_color : heat_bear_color
    
    // Row 2 (Period 5)
    oi_change_pct2 = ((C_ - C_[p2]) / C_[p2]) * 100
    row2 := 2
    row2_color := oi_change_pct2 > 0 ? heat_bull_color : heat_bear_color
    
    // Row 3 (Period 8)
    oi_change_pct3 = ((C_ - C_[p3]) / C_[p3]) * 100
    row3 := 3
    row3_color := oi_change_pct3 > 0 ? heat_bull_color : heat_bear_color
    
    // Row 4 (Period 13)
    oi_change_pct4 = ((C_ - C_[p4]) / C_[p4]) * 100
    row4 := 4
    row4_color := oi_change_pct4 > 0 ? heat_bull_color : heat_bear_color
    
    // Row 5 (Period 21)
    oi_change_pct5 = ((C_ - C_[p5]) / C_[p5]) * 100
    row5 := 5
    row5_color := oi_change_pct5 > 0 ? heat_bull_color : heat_bear_color
    
    // Row 6 (Period 34)
    oi_change_pct6 = ((C_ - C_[p6]) / C_[p6]) * 100
    row6 := 6
    row6_color := oi_change_pct6 > 0 ? heat_bull_color : heat_bear_color
    
    // Row 7 (Period 55)
    oi_change_pct7 = ((C_ - C_[p7]) / C_[p7]) * 100
    row7 := 7
    row7_color := oi_change_pct7 > 0 ? heat_bull_color : heat_bear_color


// Black background for the heatmap
bgcolor(show_oi_heatmap ? color.new(color.black, 10) : na, title="Heatmap Background")

// Plot heatmap rows
plot(show_oi_heatmap ? row1 : na, title="OI Period 3", color=row1_color, style=plot.style_columns, linewidth=1, display=display.pane)
plot(show_oi_heatmap ? row2 : na, title="OI Period 5", color=row2_color, style=plot.style_columns, linewidth=1, display=display.pane)
plot(show_oi_heatmap ? row3 : na, title="OI Period 8", color=row3_color, style=plot.style_columns, linewidth=1, display=display.pane)
plot(show_oi_heatmap ? row4 : na, title="OI Period 13", color=row4_color, style=plot.style_columns, linewidth=1, display=display.pane)
plot(show_oi_heatmap ? row5 : na, title="OI Period 21", color=row5_color, style=plot.style_columns, linewidth=1, display=display.pane)
plot(show_oi_heatmap ? row6 : na, title="OI Period 34", color=row6_color, style=plot.style_columns, linewidth=1, display=display.pane)
plot(show_oi_heatmap ? row7 : na, title="OI Period 55", color=row7_color, style=plot.style_columns, linewidth=1, display=display.pane)

// Add period labels on the right side
if show_oi_heatmap and barstate.islast
    label.new(bar_index + 2, 1, str.tostring(p1) + "d", color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    label.new(bar_index + 2, 2, str.tostring(p2) + "d", color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    label.new(bar_index + 2, 3, str.tostring(p3) + "d", color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    label.new(bar_index + 2, 4, str.tostring(p4) + "d", color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    label.new(bar_index + 2, 5, str.tostring(p5) + "d", color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    label.new(bar_index + 2, 6, str.tostring(p6) + "d", color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    label.new(bar_index + 2, 7, str.tostring(p7) + "d", color=color.new(color.black, 100), textcolor=color.white, style=label.style_label_left, size=size.tiny)
